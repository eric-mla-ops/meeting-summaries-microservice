PORT=3000

# --- required (the service refuses to start without them) ---------------------------------
# Same Supabase project as mla-notes-sync (service role: server-side only, never commit).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# HubSpot Service Key (Bearer). Scopes: contacts read/write, meetings read/write,
# crm.schemas.contacts.write (optional: lets the service create the mla_provisional property).
HUBSPOT_SERVICE_KEY=
# Shared secret callers send as the X-API-Key header (POST /summaries, /backfill, /reconcile).
SERVICE_API_KEY=

# --- safety switch ----------------------------------------------------------------------
# OFF by default. Enabling writes to the production HubSpot CRM and creates provisional
# contacts. While off, POST /summaries acknowledges and does nothing, real backfills and
# reconcile --apply return 409, and the sweeper is idle; dry-runs still work.
HUBSPOT_SUMMARY_PUSH_ENABLED=false
# Earliest client_interactions.created_at the retry sweeper may push (never an unscoped sweep).
HUBSPOT_PUSH_SINCE=

# --- tuning (defaults shown) ------------------------------------------------------------
MATCH_WINDOW_MINUTES=30
HUBSPOT_MAX_ATTEMPTS=5
# Retry sweeper interval; 0 disables it.
SWEEP_INTERVAL_MINUTES=60
